# Open-vocabulary initial bounding-box proposals. The default Apache-2.0
# Grounding DINO Tiny model downloads once and is then run locally.
JANO_DETECTION_PROVIDER=grounding_dino
GROUNDING_DINO_MODEL_ID=IDEA-Research/grounding-dino-tiny
GROUNDING_DINO_DEVICE=auto

# The launcher installs official SAM 2.1 and uses the verified small checkpoint
# in checkpoints/ by default. mock is only for tests/UI development.
JANO_SEGMENTATION_PROVIDER=sam2

# Default SAM 2.1 workstation configuration. The repository-local checkpoint is
# discovered automatically when SAM2_CHECKPOINT_PATH is left unset.
SAM2_REVISION=2b90b9f5ceec907a1c18123530e92e794ad901a4
SAM2_DEVICE=auto
SAM2_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml

# Official repository: https://github.com/facebookresearch/sam3
SAM3_REVISION=46957e47805eaa273f4aa7bbbd25a88bca9108ce
SAM3_REPO_PATH=C:\path\to\sam3
SAM3_DEVICE=cuda
# Either point to an official local checkpoint, or allow the official builder
# to retrieve facebook/sam3 using the workstation's normal Hugging Face auth.
SAM3_CHECKPOINT_PATH=C:\path\to\sam3.pt
SAM3_LOAD_FROM_HF=false
SAM3_CONFIDENCE_THRESHOLD=0.35

# Optional explicit SAM 2.1 checkout/checkpoint overrides.
# Official repository: https://github.com/facebookresearch/sam2
# Revision inspected and supported by this application.
SAM2_REPO_PATH=C:\path\to\sam2
# Default when no local checkpoint is configured. Requires huggingface_hub.
SAM2_MODEL_ID=facebook/sam2.1-hiera-small

# Recommended reproducible path: use the official public SAM 2.1 small checkpoint.
SAM2_CHECKPOINT_PATH=C:\path\to\sam2\checkpoints\sam2.1_hiera_small.pt
SAM2_CHECKPOINT_SHA256=6d1aa6f30de5c92224f8172114de081d104bbd23dd9dc5c58996f0cad5dc4d38
